# Keep the build context small and reproducible: nothing here is needed to
# install dependencies, type-check, test, or build the site.

# Version control and editor/OS noise
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp
*.swo
.DS_Store

# Host-installed dependencies and local build output (rebuilt inside the image)
node_modules
dist
build
out
coverage
.vite
*.tsbuildinfo

# Secrets: never bake environment files into an image
.env
.env.*
!.env.example

# Local/generated artifacts
screenshots
save_games
*.save
*.log
*.tgz
session-*.md
